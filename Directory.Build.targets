<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- KSP does not need debug symbols in GameData; drop any PDBs copied with the DLLs. -->
  <Target Name="RemovePluginPdbs" AfterTargets="KSPBT_CopyDLLsToPluginFolder" BeforeTargets="DeployGameDataToKsp">
    <ItemGroup>
      <_PluginPdbs Include="$(KSPBT_ModRoot)\$(KSPBT_ModPluginFolder)\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PluginPdbs)" ContinueOnError="true" />
  </Target>
</Project>
