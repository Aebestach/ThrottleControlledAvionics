<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>3.9.0</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyName>ThrottleControlledAvionics</AssemblyName>
    <RootNamespace>ThrottleControlledAvionics</RootNamespace>
    <TargetFramework>net481</TargetFramework>
    <Description>Plugin for the Kerbal Space Program</Description>
    <Product>ThrottleControlledAvionics</Product>
    <Copyright>Allis Tauri</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(KSPBT_ModVersion)' != '' ">
    <Version>$(KSPBT_ModVersion)</Version>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- Preserve prior Compile list: these sources were not part of the classic project -->
  <ItemGroup>
    <Compile Remove="GUI\HUD\ManeuverWindow.cs" />
    <Compile Remove="Modules\Orbit\MatchPlaneAutopilot.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AT_Utils\src\AT_Utils\AT_Utils.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\..\AT_Utils\src\AT_Utils.UI\AT_Utils.UI.csproj">
      <Private>false</Private>
      <KSPAssemblyName>0_00_AT_Utils_UI</KSPAssemblyName>
      <KSPAssemblyVersion>1.0</KSPAssemblyVersion>
    </ProjectReference>
    <ProjectReference Include="..\TCA.UI\TCA.UI.csproj">
      <Private>true</Private>
      <KSPAssemblyName>TCA.UI</KSPAssemblyName>
      <KSPAssemblyVersion>1.0</KSPAssemblyVersion>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)/ThrottleControlledAvionics.version</Destination>
      <URL>https://github.com/Aebestach/ThrottleControlledAvionics/releases/latest/download/ThrottleControlledAvionics.version</URL>
      <Download>https://github.com/Aebestach/ThrottleControlledAvionics/releases/latest</Download>
      <KSP_Version>1.12.5</KSP_Version>
      <KSP_Version_Min>1.12.0</KSP_Version_Min>
      <KSP_Version_Max>1.12.99</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>

  <Target Name="DeployGameDataToKsp" AfterTargets="KSPBT_CopyDLLsToPluginFolder" Condition=" '$(KSPBT_GameRoot)' != '' ">
    <PropertyGroup>
      <_KspModDeployDir>$(KSPBT_GameRoot)/GameData/ThrottleControlledAvionics</_KspModDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_ModDeployFiles Include="$(KSPBT_ModRoot)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModDeployFiles)" DestinationFolder="$(_KspModDeployDir)/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="Deployed GameData to $(_KspModDeployDir)" Importance="high" />
  </Target>
</Project>
