<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyName>TCA.UI</AssemblyName>
    <RootNamespace>TCA.UI</RootNamespace>
    <TargetFramework>net481</TargetFramework>
    <Description>UI logic assembly for Throttle Controlled Avionics</Description>
    <Product>TCA.UI</Product>
    <Copyright>Allis Tauri</Copyright>
    <KSPBT_GenerateVersionFile>false</KSPBT_GenerateVersionFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AT_Utils\src\AT_Utils.UI\AT_Utils.UI.csproj">
      <Private>false</Private>
      <KSPAssemblyName>0_00_AT_Utils_UI</KSPAssemblyName>
      <KSPAssemblyVersion>1.0</KSPAssemblyVersion>
    </ProjectReference>
  </ItemGroup>

  <!-- Also deploy into the AT_Utils Unity editor project used for UI authoring -->
  <Target Name="DeployTcaUiToEditor" AfterTargets="KSPBT_CopyDLLsToPluginFolder">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectRootDir)..\AT_Utils\editor\Assets\Plugins\" SkipUnchangedFiles="true" />
  </Target>
</Project>
